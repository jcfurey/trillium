{
  "extends": "@foxglove/tsconfig/base",
  "include": ["./src/**/*"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "node",
    "target": "es2020",
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@foxglove/studio-base/*": ["../../packages/studio-base/src/*"]
    }
  }
}
